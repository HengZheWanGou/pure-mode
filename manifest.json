{
  "manifest_version": 3,
  "name": "B站专注模式",
  "version": "1.3.1",
  "description": "屏蔽B站主页推荐，只留搜索框，帮你专注学习",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://search.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/",
        "https://www.bilibili.com/?*",
        "https://www.bilibili.com/index.html",
        "https://www.bilibili.com/index.html?*",
        "https://bilibili.com/",
        "https://bilibili.com/?*",
        "https://bilibili.com/index.html",
        "https://bilibili.com/index.html?*"
      ],
      "js": [
        "content_scripts/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://search.bilibili.com/*"
      ],
      "js": [
        "content_scripts/search.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content_scripts/video.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content_scripts/search.css"
      ],
      "matches": [
        "https://search.bilibili.com/*"
      ]
    },
    {
      "resources": [
        "content_scripts/video.css"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
